{
  "name": "your-next-awesome-package",
  "private": false,
  "version": "0.0.0",
  "description": "Start your next typescript package with a light, robust and production-ready repo.",
  "keywords": [],
  "author": "Your Name <your-email>",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf ./dist",
    "lint": "biome lint",
    "lint:fix": "npm run lint -- --fix",
    "lint:staged": "npm run lint -- --staged --no-errors-on-unmatched --files-ignore-unknown=true",
    "fmt": "biome format",
    "fmt:fix": "npm run fmt -- --fix",
    "fmt:staged": "npm run fmt -- --staged --files-ignore-unknown=true",
    "fmt-yaml": "prettier . --check",
    "fmt-yaml:fix": "prettier . --write",
    "biome": "biome check",
    "biome:fix": "npm run biome -- --fix",
    "biome:staged": "npm run biome -- --staged --no-errors-on-unmatched --files-ignore-unknown=true",
    "typecheck": "tsc -p ./src/tsconfig.json --declaration --noEmit --incremental false",
    "check": "concurrently npm:typecheck npm:biome",
    "attw": "npm run build && npx attw",
    "vitest": "vitest -c vitest.config.ts",
    "test": "npm run vitest -- --run",
    "test:cov": "npm run test -- --coverage",
    "test:html": "npm run test:cov && open ./coverage/lcov-report/index.html",
    "validate": "npm run check && npm run test:cov && npm run attw",
    "tsc:dev": "tsc -p ./src/tsconfig.dev.json",
    "tsc:build": "tsc -p ./src/tsconfig.build.json",
    "tsc-alias": "tsc-alias -p ./src/tsconfig.build.json",
    "tsc-alias:watch": "tsc-alias -p ./src/tsconfig.dev.json -w",
    "build": "npm run clean && npm run tsc:build && npm run tsc-alias",
    "build:docs": "typedoc",
    "watch:ts": "concurrently  'npm run tsc:dev -- --watch' 'npm run tsc-alias:watch'",
    "watch:tests": "npm run vitest -- --watch",
    "dev": "npm run clean && npx concurrently 'npm:watch:*'",
    "postinstall": "lefthook install"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.11",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@release-it/conventional-changelog": "^12.0.0",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.5",
    "lefthook": "^2.1.12",
    "prettier": "^3.9.6",
    "release-it": "^21.0.2",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.9.2",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
